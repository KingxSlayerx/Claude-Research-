# ─── Public business details (shown on the site; leave blank to hide) ───────────
# Canonical site URL, used for SEO metadata and the sitemap. Required in production.
NEXT_PUBLIC_SITE_URL=
# Showroom contact details. Only set values that have been verified.
NEXT_PUBLIC_SHOWROOM_PHONE=
NEXT_PUBLIC_SHOWROOM_EMAIL=
NEXT_PUBLIC_SHOWROOM_ADDRESS=
NEXT_PUBLIC_SHOWROOM_HOURS=
# WhatsApp number with country code, digits only, e.g. 919876543210. Enables WhatsApp links.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Quote storage ─────────────────────────────────────────────────────────────
# "supabase" (production) or "file" (development / single-server only).
# If unset: Supabase when configured, otherwise "file" in development and
# "not configured" (requests refused with 503) in production.
QUOTE_STORE=

# Supabase project (Settings → API). The service-role key is SECRET: server only,
# never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# File store location (QUOTE_STORE=file only).
QUOTE_FILE_PATH=.data/quotes.json

# ─── Staff sessions ────────────────────────────────────────────────────────────
# At least 32 random characters, e.g. `openssl rand -base64 48`. Required in production.
SESSION_SECRET=
# Set to 1 only when testing a production build over plain http://localhost.
SESSION_COOKIE_INSECURE=

# File-store staff account (QUOTE_STORE=file only). Create the hash with:
#   npm run hash-password -- 'a long passphrase'
STAFF_EMAIL=
STAFF_NAME=Showroom
STAFF_PASSWORD_HASH=

# Set to 1 when behind a proxy/CDN that sets X-Forwarded-For (e.g. Vercel), so
# rate limits apply per customer rather than per proxy.
TRUST_PROXY=
